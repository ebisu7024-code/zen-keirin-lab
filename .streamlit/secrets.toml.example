ZEN_KEIRIN_APP_PASSWORD = "change-this-before-deploy"
# Supabase / PostgreSQL を使う場合だけ設定する。
# このアプリのRender公開版は、ZEN_KEIRIN_DATABASE_URL が未設定でも
# ZEN_KEIRIN_APP_PASSWORD を使って Supabase の app role に接続します。
# 別DBに向ける場合だけ明示的に設定してください。
ZEN_KEIRIN_DATABASE_URL = "postgresql://postgres.xxxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
# 起動時にTIPSTAR参照レースの結果を何件まで自動反映するか。0で無効化。
ZEN_KEIRIN_TIPSTAR_RESULT_SYNC_LIMIT = "5"
